WEB_PORT=8780
API_PORT=8781
BIND_ADDRESS=0.0.0.0
# Enable when the browser URL uses HTTPS. Both public URLs should use HTTPS.
AGENTCHAT_SECURE_COOKIE=0
# Public self-service registration after the first administrator initializes the site.
AGENTCHAT_REGISTRATION_OPEN=1
# Optional exact extra browser origins, comma-separated. UI uses its same-origin /api proxy.
AGENTCHAT_ORIGINS=
# Canonical HTTPS agent URL, including an optional path prefix.
# Overrides stale browser-saved API URLs in the setup dialog.
AGENTCHAT_PUBLIC_API_URL=
